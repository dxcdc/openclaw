[Unit]
Description=OpenClaw Celery Worker
After=network.target redis.service postgresql.service

[Service]
User=root
WorkingDirectory=/var/www/openclaw/web
ExecStart=/var/www/openclaw/web/.venv/bin/celery -A config worker --loglevel=INFO
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
